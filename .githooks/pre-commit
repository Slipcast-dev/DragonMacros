#!/bin/sh
# Блокирует коммит с секретами, ключами, большими файлами и сборочным мусором.
fail=0
files=$(git diff --cached --name-only --diff-filter=ACM)
for f in $files; do
  case "$f" in
    *.p12|*.pfx|*.pem|*.key|*.cer|*.mobileprovision|*.provisionprofile|*.keychain*|.env|.env.*|id_rsa*|id_ed25519*|*.dmg|.DS_Store|*/.DS_Store|.build/*|dist/*)
      echo "pre-commit: запрещённый файл: $f"; fail=1;;
  esac
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  [ "$size" -gt 5242880 ] && { echo "pre-commit: файл больше 5 МБ: $f"; fail=1; }
done
if git diff --cached -U0 -- . ':!.githooks' | grep -E '^\+' | grep -I -E -- '-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|sk-[A-Za-z0-9]{32,}|xox[baprs]-[A-Za-z0-9-]{10,}' >/dev/null; then
  echo "pre-commit: похоже на секрет (ключ/токен) в добавленных строках"; fail=1
fi
[ $fail -ne 0 ] && { echo "Коммит отменён."; exit 1; }
exit 0
